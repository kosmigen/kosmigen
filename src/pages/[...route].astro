---
import SiteLayout from '../layouts/SiteLayout.astro';
import { routePaths } from '../lib/pages';

export function getStaticPaths() {
  return routePaths.filter((route) => !route.endsWith('.html') && route !== '404/').map((route) => ({
    params: { route: route.replace(/\/$/, '') || undefined },
    props: { route },
  }));
}
---
<SiteLayout route={Astro.props.route} />
