---
import { href, posts, type Entry } from '../lib/content';
import PostMeta from './PostMeta.astro';
const { post, html, headingId } = Astro.props as { post: Entry; html: string; headingId?: string };
const imageLayout = post.meta.image_layout || 'top';
const index = posts.findIndex(({ route }) => route === post.route);
---
<div class="kb-blog-post">
  <nav class="kb-blog-post-back" aria-label="博客导航">
    <a class="kb-blog-post-back__link" href={href('blog/')}><span aria-hidden="true">←</span> 返回博客</a>
  </nav>
  <h1 id={headingId}>{post.title}{headingId && <a class="headerlink" href={'#' + headingId} title="链接到本节">¶</a>}</h1>
  <div class={`kb-blog-post-header kb-blog-post-header--image-${imageLayout}`}>
    <div class="kb-blog-post-header__meta"><PostMeta post={post} /></div>
    {post.meta.image && <figure class="kb-blog-post-cover"><img src={post.meta.image} alt={post.meta.image_alt ?? ''} loading="eager" decoding="async" /></figure>}
  </div>
  <Fragment set:html={html} />
  <nav class="kb-blog-post-nav" aria-label="相邻文章">
    {posts[index + 1] && <a class="kb-blog-post-nav__link" href={href(posts[index + 1].route)}>上一篇 · {posts[index + 1].title}</a>}
    {index > 0 && <a class="kb-blog-post-nav__link kb-blog-post-nav__link--next" href={href(posts[index - 1].route)}>下一篇 · {posts[index - 1].title}</a>}
  </nav>
</div>
