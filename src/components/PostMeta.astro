---
import { authors, defaultAuthors, href, postTags, readingStats, type Entry } from '../lib/content';
const { post } = Astro.props as { post: Entry };
const people = (post.meta.authors ?? defaultAuthors).map((id) => authors[id]).filter(Boolean);
const tags = postTags(post);
const { words, readtime } = readingStats(post);
---
<ul class="kb-blog-post-meta" aria-label="文章信息">
  {people.map((author) => <li class="kb-blog-post-meta__item kb-blog-post-meta__authors">
    <a class="kb-blog-post-meta__author" href={href(author.url || 'about/author/')} title={author.description}>{author.name}</a>
  </li>)}
  <li class="kb-blog-post-meta__item"><time datetime={post.date} title="发布日期">{post.date.replaceAll('-', '.')}</time></li>
</ul>
<div class="kb-blog-post-details">
  {tags.length > 0 && <ul class="kb-blog-post-tags" aria-label="文章标签">
    {tags.map((tag) => <li><a href={href('blog/tags/#tag:' + tag)}>{tag}</a></li>)}
  </ul>}
  <ul class="kb-blog-post-stats" aria-label="阅读信息" lang="en">
    <li title="预计阅读时间">{readtime} min read</li>
    <li title="正文字数">{words} words</li>
  </ul>
</div>
