---
import { entriesByRoute, href, updates } from '../lib/content';
import { originalArticle } from '../lib/pages';
import ProjectCard from './ProjectCard.astro';
import NowPage from './NowPage.astro';
import BlogPost from './BlogPost.astro';
import BlogList from './BlogList.astro';
const { route, html, headingId } = Astro.props;
const entry = entriesByRoute.get(route);
const isNow = route.startsWith('now/');
const isListing = route.startsWith('blog/') && entry?.kind !== 'post';
const newDocs = route === 'notes/overview/'
  ? [...entriesByRoute.values()].filter((page) => page.route.startsWith('notes/') && !originalArticle(page.route))
  : [];
---
{isListing ? <BlogList route={route} /> : (
  <article class="md-content__inner md-typeset">
    {entry?.kind === 'post' ? <BlogPost post={entry} html={html} headingId={headingId} /> :
      isNow ? <NowPage entry={entry || updates[0]} html={html} /> :
      route === 'projects/' ? <section class="kb-projects" aria-label="项目展示">
        {(entry?.meta.projects ?? []).map((project) => <ProjectCard project={project} />)}
        <Fragment set:html={html} />
      </section> : <>
        {!/<h1(?:\s|>)/i.test(html) && <h1>{entry?.title}</h1>}
        <Fragment set:html={html} />
        {newDocs.length > 0 && <section>
          <h2>新增文档</h2>
          <ul>{newDocs.map((page) => <li><a href={href(page.route)}>{page.title}</a></li>)}</ul>
        </section>}
      </>}
  </article>
)}
